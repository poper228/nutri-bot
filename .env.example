# --- Telegram ---
BOT_TOKEN=

# --- LLM provider switch ---
# Допустимые значения: gemini, anthropic
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (резервный провайдер, можно оставить пустым) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- PostgreSQL ---
POSTGRES_USER=nutri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nutri
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LECTURES_COLLECTION=lecture_chunks_v1

# --- Embeddings ---
# Размерность должна совпадать с выходом модели (для multilingual-e5-large = 1024).
# При смене модели правь обе переменные одновременно и подними новую коллекцию (_v2).
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# --- App ---
LOG_LEVEL=INFO
