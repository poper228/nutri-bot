# --- Telegram ---
BOT_TOKEN=

# --- LLM provider switch ---
# Допустимые значения: gemini, anthropic
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (резервный провайдер, можно оставить пустым) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- PostgreSQL ---
POSTGRES_USER=nutri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nutri
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- App ---
LOG_LEVEL=INFO
